# OpenAI API key (https://platform.openai.com/api-keys)
# Required for OpenAI endpoint. Leave empty if using a self-hosted VPS endpoint.
ALX_WHISPER_API_KEY=sk-your-key-here

# Endpoint URL (OpenAI-compatible transcription API)
ALX_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# Model name
ALX_WHISPER_MODEL=whisper-1

# Language hint (ISO-639-1, e.g. "es", "en"). Empty = auto-detect.
ALX_WHISPER_LANGUAGE=es

# Hotkey: use 'ctrl+shift+space' as default (matches Wispr Flow muscle memory)
ALX_WHISPER_HOTKEY=ctrl+shift+space

# Audio: sample rate (Hz). 16000 is enough for speech.
ALX_WHISPER_SAMPLE_RATE=16000

# Behavior
ALX_WHISPER_MAX_RECORD_SECONDS=120
ALX_WHISPER_RESTORE_CLIPBOARD_DELAY=2.0
